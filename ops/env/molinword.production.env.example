# 运行环境
APP_ENV=production
NODE_ENV=production
APP_NAME=moling_word
APP_RELEASE_ID=replace-with-release-id
APP_HOST=127.0.0.1
APP_PORT=3001
LOCAL_API_PORT=3001
APP_BASE_URL=https://word.example.com
TRUSTED_ORIGINS=
TRUSTED_PROXY_HOPS=1
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=86400
LOCAL_MOLING_MOCK=false
REQUIRE_MOLING_SESSION=true
ACCESS_LOG_ENABLED=true

# 单实例保护；Nginx 仍承担入口层限流
RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30
AI_MAX_CONCURRENT_REQUESTS=8
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=420000

# 墨灵平台与计费
MOLING_API_BASE_URL=https://platform.example.com
INTERNAL_API_TOKEN=replace-with-secret-manager-value
MOLING_INTERNAL_TIMEOUT_MS=10000
MOLING_APP_ID=replace-with-app-id
MOLING_PRODUCT_ID=replace-with-product-id
MOLING_USER_ENTITLEMENT_MAP=
MOLING_DEFAULT_ENTITLEMENT_ID=
BILLING_RECONCILIATION_OUTBOX=/var/lib/molinword/billing-reconciliation-outbox.jsonl

# OpenAI 兼容模型或开源模型网关
LLM_PROVIDER=http
LLM_API_URL=https://gateway.example.com/v1/chat/completions
LLM_READINESS_URL=https://gateway.example.com/v1/models
LLM_API_KEY=replace-with-secret-manager-value
LLM_MODEL=replace-with-approved-model
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# AI 审计仅保存不可逆摘要和统计信息；保留周期须经业务与隐私负责人批准
AI_AUDIT_CONTENT_MODE=metadata
AI_AUDIT_HASH_KEY=replace-with-secret-manager-value
AI_AUDIT_RETENTION_DAYS=30
AI_AUDIT_CLEANUP_BATCH_SIZE=1000
AI_AUDIT_CLEANUP_MAX_BATCHES=20
AI_AUDIT_REDACTION_BATCH_SIZE=10

# MySQL 与 MinIO
DATABASE_URL=mysql://moling_word_app:replace-with-secret-manager-value@db.internal:3306/moling_word
STORAGE_ENDPOINT=https://minio.example.com
STORAGE_BUCKET=moling-word
STORAGE_ACCESS_KEY_ID=replace-with-secret-manager-value
STORAGE_SECRET_ACCESS_KEY=replace-with-secret-manager-value

# 公网环境必须保持 false；仅受控内网链路可评审后修改
ALLOW_INSECURE_INTERNAL_HTTP=false
