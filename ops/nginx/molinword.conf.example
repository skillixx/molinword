# 中文注解：本文件安装到 /etc/nginx/sites-available/molinword.conf 前，必须替换域名和证书路径。
limit_req_zone $binary_remote_addr zone=molinword_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=molinword_ai:10m rate=2r/s;

server {
    listen 80;
    listen [::]:80;
    server_name word.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name word.example.com;

    ssl_certificate /etc/letsencrypt/live/word.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/word.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MOLINWORD_SSL:10m;
    ssl_session_timeout 1d;

    root /opt/molinword/current/dist;
    index index.html;
    client_max_body_size 20m;

    # 中文注解：与仓库性能门禁统一使用六级 gzip，确保预算反映生产实际传输而不是只在构建机压缩。
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/javascript text/javascript text/css application/json image/svg+xml;

    include /etc/nginx/snippets/molinword-security-headers.conf;

    # 中文注解：AI 路由同时受通用 API 和更严格 AI 桶约束，且必须写在 /api/ 之前。
    location ^~ /api/ai/ {
        limit_req zone=molinword_api burst=30 nodelay;
        limit_req zone=molinword_ai burst=6 nodelay;
        limit_req_status 429;
        error_page 429 = @molinword_ai_rate_limited;

        include /etc/nginx/snippets/molinword-proxy.conf;
    }

    location ^~ /api/ {
        limit_req zone=molinword_api burst=30 nodelay;
        limit_req_status 429;
        error_page 429 = @molinword_api_rate_limited;

        include /etc/nginx/snippets/molinword-proxy.conf;
    }

    # 中文注解：Nginx 在应用之前触发限流时，也返回可机器识别的重试窗口与中文 JSON。
    location @molinword_ai_rate_limited {
        include /etc/nginx/snippets/molinword-security-headers.conf;
        add_header Retry-After "1" always;
        add_header RateLimit-Limit "2" always;
        add_header RateLimit-Remaining "0" always;
        add_header RateLimit-Reset "1" always;
        default_type application/json;
        return 429 '{"message":"AI 请求过于频繁，请稍后重试。"}';
    }

    location @molinword_api_rate_limited {
        include /etc/nginx/snippets/molinword-security-headers.conf;
        add_header Retry-After "1" always;
        add_header RateLimit-Limit "10" always;
        add_header RateLimit-Remaining "0" always;
        add_header RateLimit-Reset "1" always;
        default_type application/json;
        return 429 '{"message":"请求过于频繁，请稍后重试。"}';
    }

    location = /index.html {
        include /etc/nginx/snippets/molinword-security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # 中文注解：许可证入口没有内容哈希，必须禁止缓存，确保用户看到的声明与当前运行版本一致。
    location = /THIRD_PARTY_LICENSES.txt {
        include /etc/nginx/snippets/molinword-security-headers.conf;
        add_header Cache-Control "no-store" always;
        default_type text/plain;
        charset utf-8;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        include /etc/nginx/snippets/molinword-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # 中文注解：发布清单仅供服务器本地完整性校验，公网通过健康接口获取最小发布号，避免暴露完整制品摘要。
    location = /release-manifest.json {
        return 404;
    }

    # 中文注解：Vite History 路由统一回退到 index.html，刷新工作台、模板库和编辑器路由不会 404。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
